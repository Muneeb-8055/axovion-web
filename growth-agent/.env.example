# ==========================================
# AXOVION AI AGENT ENVIRONMENT CONFIGURATION
# ==========================================

# --- CHOOSE YOUR AI BRAIN ---
# Options: 'openai', 'gemini', or 'groq'
AI_PROVIDER=openai

# 1. OpenAI (GPT-4o-mini / GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 2. Google Gemini (100% Free - 1,500 free calls/day, No credit card)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 3. Groq (100% Free - Ultra fast)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- AGENCY PROFILE ---
AGENCY_NAME=Axovion.io
AGENCY_URL=https://www.axovion.io
FOUNDER_NAME=Muneeb ur Rehman
COFOUNDER_NAME=Muhammad Hamza Zafar
CALENDAR_LINK=https://cal.com/axovion/audit

# --- OUTBOUND EMAIL DISPATCHER (100% Free Options) ---
# Option A: Free Resend API (3,000 free emails/mo from your domain)
# Get key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here
SENDER_EMAIL=hamza@axovion.io

# Option B: Standard SMTP / Gmail App Password
# (If using Gmail: Generate 16-char App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SENDER_NAME="Muhammad Hamza Zafar | Axovion"

